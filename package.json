{
  "name": "vitru-rotina-voz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client,analytics -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:analytics\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "dev:analytics": "npm --prefix Analytics/vitru-analytics-dashboard run dev -- --host 127.0.0.1 --port 5174",
    "build": "npm run build:analytics && tsc --noEmit && vite build --config vite.config.ts",
    "build:analytics": "npm --prefix Analytics/vitru-analytics-dashboard run build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/schedule-validation.test.ts tests/academic-calendar.test.ts tests/voice-diagnostics.test.ts tests/routine-extraction.test.ts tests/routine-normalization.test.ts tests/voice-profile.test.ts",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
